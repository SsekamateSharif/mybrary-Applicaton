<!--We will create our new author page form here -->
<h2 class = "page-header">New Author</h2>
<!--We then create the form-->
<form action = "/authors" method = "POST">
    <!--The method for our form has to be POST since we will use it to create a new author and action should be to our authors-->
    <!--We then include our _form_fields.ejs file in our new.ejs-->
    <%- include('_form_fields') %> 
    <div class = "form-row form-row-end btn-row">
        <!--We the create our links/buttons for canceling and submitting our form-->
        <a class = "btn btn-danger" href = "/authors">Cancel</a>
        <button class = "btn btn-primary" type = "submit">Create</button>
    </div>
</form>