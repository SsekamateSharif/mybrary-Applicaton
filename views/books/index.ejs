<!--We add code for our index / home page for our books-->
<h2 class = "page-header">Search Books</h2>
<!--We create a form that has action on books index page and its method is getting since it gets all books from the database-->
<form action = "/books" method = "GET">
    <div class = "form-row">
        <div class = "form-item">
            <!--we create the first label for our input fields-->
            <label>Title</label>
            <!--We put our input field for our book title-->
            <!--we add the name search condition as the value of our input field since we will search for the books from the database by their titles.-->
            <input type = "text" name = "title" value = "<%= searchOptions.title %>">
        </div>
        <div class = "form-item">
            <!--input for our published after date we will use this as search option condition as well-->
            <label>Published After</label>
            <!--input field; type: date-->
            <input type = "date" name = "publishedAfter" value = "<%= searchOptions.publishedAfter %>">
        </div>
    </div>
    <div class = "form-row">
        <div class = "form-item-date">
            <!--input for published before date search option-->
            <label>Published Before</label>
            <input type = "date" name = "publishedBefore" value = "<%= searchOptions.publishedBefore %>">
        </div>
    </div>
    <div class = "form-row form-row-end btn-row">
        <!--Then we add our search button-->
        <button class = "btn btn-primary" type ="submit">Search</button>
    </div>
</form>
<br>
<div class = "form-row-images">
    <!--we need to display our authors using a for-each loop below the form after searching for them-->
    <% books.forEach(book => { %>
        <div class = "form-images">
            <!--we display each book by its image after iterating through an array of books from the database-->
            <a href = "/books/<%=book.id%>"> 
                <img height = "150" width = "100" src = "<%=book.coverImagePath%>"> 
            </a>
        </div>
    <% }) %>
</div>