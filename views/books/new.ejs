<!--We will create our new book page form here -->
<h2>New Book</h2>
<!--We then create the form-->
<!--We need to tell our browser to encode our data in multipart form type.-->
<form action = "/books" method = "POST" >
    <!--The method for our form has to be POST since we will use it to create a new book and action should be to our books home page-->
    <!--We then include our _form_fields.ejs file in our new.ejs-->
    <%- include('_form_fields') %> 
    <!--We the create our links/buttons for canceling and submitting our form-->
    <a href = "/books">Cancel</a> <!--This links to our books home page-->
    <button type = "submit">Create</button>
</form>