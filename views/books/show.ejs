<h2 class = "page-header"><%=book.title%></h2> <!--The title for our book on our book show page-->
<!--We display the image for the book cover-->
<img height = "150" width = "100" src = "<%=book.coverImagePath%>">
<br>
<!--Then below here we have to display our book information-->
<!--Author info-->
<div>
    Author: <%=book.author.name%>
</div>
<!--Publish date info-->
<div>
    Publish Date: <%=book.publishDate.toDateString()%>
</div>
<!--Page count info-->
<div>
    Page Count: <%=book.pageCount%>
</div>
<!--Edit link-->
<a href = "/books/<%=book.id%>/edit">Edit</a>
<!--Delete Link-->
<!--We include the partials file for deleteForm-->
<%-include('../partials/deleteForm', {url: `/books/${book.id}` })%>
<!--View Author link-->
<a href = "/authors/<%=book.author.id%>">View Author</a>