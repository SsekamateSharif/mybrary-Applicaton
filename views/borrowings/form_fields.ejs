<!--We create our inputs here-->
<div class="form-row">
    <div class="form-item ">
        <label>Due Date Update</label>
        <input type="date" name="dueDate" value="<%=borrowings.dueDate%>">
        <label>Borrow Date Update</label>
        <input type="date" name="borrowDate" value="<%=borrowings.borrowDate%>">
    </div>
    <div class="form-item">
        <label>Return Date Update</label>
        <input type="date" name="returnDate" value="<%=borrowings.returnDate%>">
        <label>Status Update</label>
        <input type="text" name="status" value="<%=borrowings.status%>">
    </div>
</div>
<div class="form-item Borrowings-info approvedby">
        <label>Approved By</label>
        <input type="text" name="approvedBy" value="<%=borrowings.approvedBy%>">
</div>