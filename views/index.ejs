<h2 class = "page-header">Recently Added</h2>
<div>
    <!--Iterate through our books from the database and then display them-->
    <% books.forEach(book => { %>
        <a href = "/books/<%=book.id%>">
            <img height = "150" width = "100" src = "<%=book.coverImagePath%>">
        </a>
    <% }) %>
</div>
