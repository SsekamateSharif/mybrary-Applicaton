<!--We are going to create our header for our application here-->
<!--We need a header tag-->
<header>
    <!--We then need to create a navigation bar for our app header with different links-->
    <nav class = "header-nav">
        <!--We add our main page / home page link here -->
        <a class = "header-title" href = "/">Mybrary</a> <!--This links to the home page of our application-->
        <!--for the other links in our navigation bar we will embed them in one unordered list-->
        <ul>
            <li class = "header-link"><a href = "/authors" >Authors</a></li> <!--This links to the authors index / home page-->
            <li class = "header-link"><a href = "/authors/new" >Add Authors</a></li> <!--This links to the new authors page-->
            <li class = "header-link"><a href = "/books">Books</a></li> <!--This links to the books index / home page -->
            <li class = "header-link"><a href = "/books/new" >Add Books</a></li> <!--This links to the new books page-->
            <!--We add our borrower pages dropdown menu in our application header-->
            <li class = "header-link">
                    <!--Our main nav link-->
                    <a class="dropdown-btn">Borrower Management</a>
                    <!--Then we create our other borrowers pages links-->
                    <div class="dropdown">
                        <ul class="menu">
                            <li><a href="/borrowers">All Borrowers</a></li>
                            <li><a href="/borrowers/new">Add Borrower</a></li>
                        </ul>
                    </div>
            </li>
        </ul>
    </nav>
</header>